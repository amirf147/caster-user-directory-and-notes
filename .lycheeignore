# Lychee Link Checker Ignore List
# Ignore untracked local machine configuration and private state files
settings/.*
data/.*
sikuli/.*
plugins/.*
caster_user_content/plugins/.*
environment_variables\.py
window_aliases\.json
\.var_positions\.json

# Web archive URLs (frequently rate-limited or return HTTP 429 in automated CI runners)
https://web\.archive\.org/.*
https://gist\.github\.com/Aetopia/.*
